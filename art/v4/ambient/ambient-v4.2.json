  "sail": "continuous; fps 5 (storm 8)",
  "wake": "continuous 6 fps",
  "waterline": "continuous, 6 s cycle (see motion.roll)",
  "sea_overlay": "continuous; shimmer 3 fps, foam 2 fps (storm 4)",
  "gull": "RARE: every 20-40 s (night: none, storm: every 60-90 s), 1-2 gulls cross in 8-12 s at y 20-600, sine +-6 px; flap 8 fps for 1 s then glide (frame 1) 1-2 s; shadow follows at +10,+22",
  "jump_fish": "every 25-60 s, day/dusk/night, on open sea (x<50 or x>352, or y>600), one shot 0.8 s",
